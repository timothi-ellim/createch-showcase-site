---
import Layout from '../../src/layouts/WorkspaceLayout.astro';
import ParticipantGuide from '../../src/components/ParticipantGuide.astro';
import { event } from '../../src/data/catalogue';
const singleSignIn = import.meta.env.PUBLIC_PARTICIPANT_AUTH_V2 === 'true';
---

<Layout title="Participant help">
  <section class="wrap section">
    <h1>Prepare your showcase page</h1>
    <ParticipantGuide />
    <ol>
      <li>
        {singleSignIn
          ? 'Use the email address in your organiser invitation. Choose Email me a code, or I already have a code if you have an unused code.'
          : 'Use the email address in your organiser invitation. If an Access screen appears, verify the same approved email address there first.'}
      </li>
      <li>
        {singleSignIn
          ? 'Enter the latest six-digit code and choose Continue. Codes expire 24 hours after sending. Choose Send a new code when the countdown ends if you need a replacement.'
          : 'On the participant sign-in page, enter your invitation code and select “This is my first invitation code”. For later visits, use “Send email code”.'}
      </li>
      <li>
        Open your assigned project. Add your public name, project description,
        images, image descriptions and credits. Save your draft as you go.
      </li>
      <li>
        When you are ready, submit a saved version for review and confirm your
        permission to publish it.
      </li>
    </ol>
    <p>
      Submission, approval and publication are separate steps. Your current
      public page stays online while later edits are reviewed.
    </p>
    <p>
      If your invitation has not arrived, a code has expired or your project is
      missing,{' '}
      {event.publicContact ? (
        <a href={`mailto:${event.publicContact.email}`}>
          contact CreaTech support at {event.publicContact.email}
        </a>
      ) : (
        'contact the organiser through your existing correspondence'
      )}
      . Invitations are being prepared for all {event.participants.length}{' '}
      participants. There is no public account registration.
    </p>
    <p>
      <a class="button dark" href="/participant/login/">
        Participant sign in
      </a>
    </p>
  </section>
</Layout>
