# Browser configuration: only publishable key, never a service/secret key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_PORTAL_ENVIRONMENT=local
# Exact public origin used only for workspace QR image CSP; must match the release origin.
PUBLIC_PROJECT_ASSET_ORIGIN=https://createch-showcase.pages.dev
# Candidate only until hosted hook, expiry, abuse controls and routing pass.
PUBLIC_PARTICIPANT_AUTH_V2=false
# Exact descriptor for a v2 workspace build; public deployment metadata only.
CREATECH_WORKSPACE_DESCRIPTOR=
# Edge functions only. Use a fresh random secret of at least 32 characters.
PARTICIPANT_AUTH_ORIGINS=
PARTICIPANT_AUTH_PEPPER=
# Set after read-back verification, not as a substitute for that verification.
PARTICIPANT_AUTH_RELEASE_READY=
# Protected Node worker environment. Never prefix these with PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PORTAL_ENVIRONMENT=local
PORTAL_APP_ORIGIN=http://127.0.0.1:4321
# Optional exact old app origins; required ISO expiry ends compatibility.
PORTAL_COMPATIBILITY_ORIGINS=
PORTAL_COMPATIBILITY_UNTIL=
REVIEWED_SOURCE_COMMIT=
# Fixed hosting target: configured only after account/release approval.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CREATECH_PAGES_PROJECT=
CREATECH_CANONICAL_ORIGIN=
CREATECH_HOSTING_ENABLED=false
CREATECH_CANDIDATE_PROTECTION_VERIFIED=false
CREATECH_PRODUCTION_BRANCH=main
CREATECH_RECONCILIATION_ENABLED=false
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Edge function only: fixed repository/workflow dispatch configuration.
CREATECH_GITHUB_REPOSITORY=
CREATECH_GITHUB_WORKFLOW=portal-worker.yml
CREATECH_GITHUB_REF=
CREATECH_GITHUB_TOKEN=

# Visitor reminders: build switches are public; credentials below are server-only.
# Pass PUBLIC_REMINDERS_* as process environment variables to the build command.
# These two flags intentionally cannot be enabled by a Vite-loaded .env file alone.
# Production signup additionally requires an exact local launch-readiness receipt.
PUBLIC_REMINDERS_ENABLED=false
PUBLIC_REMINDERS_PREVIEW=false
CREATECH_REMINDERS_LAUNCH_RECEIPT=
# Automated publication accepts the same reviewed receipt as a GitHub environment
# secret; use this OR the file path, never both. It is never passed to the browser.
CREATECH_REMINDERS_LAUNCH_RECEIPT_JSON=
# Cloudflare Pages Functions bindings; never prefix these with PUBLIC_.
REMINDERS_ENABLED=false
REMINDERS_ORIGIN=
REMINDERS_SUPABASE_URL=
REMINDERS_SUPABASE_SECRET=
REMINDERS_TOKEN_SECRET=
REMINDERS_WEBHOOK_SECRET=
# Scheduled Edge function; use a distinct scheduler secret of at least 32 characters.
REMINDERS_DELIVERY_ENABLED=false
REMINDERS_SCHEDULER_SECRET=
REMINDERS_GMAIL_USER=
REMINDERS_GMAIL_APP_PASSWORD=
