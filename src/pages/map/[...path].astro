---
import Layout from '../../layouts/Layout.astro';
import { hasMapPreview } from '../../data/exhibition-map';
export function getStaticPaths() {
  return hasMapPreview ? [{ params: { path: undefined } }] : [];
}
---
<Layout title="Explore the showcase" noIndex>
  <div class="wrap section">
    <h1>The map is now part of Explore.</h1>
    <p class="lead">Browse the projects and find them at Canopy in one place.</p>
    <a class="button lime" href="/explore/?mode=map#explore-map">Explore projects and the map</a>
  </div>
</Layout>
<script>
  const destination = new URL('/explore/', location.origin);
  destination.search = location.search;
  destination.searchParams.set('mode', 'map');
  destination.hash = location.hash;
  location.replace(destination);
</script>
