---
import Layout from '../../layouts/Layout.astro';
import ExhibitionMap from '../../components/ExhibitionMap.astro';
import { hasMapPreview } from '../../data/exhibition-map';
export function getStaticPaths() {
  return hasMapPreview ? [{ params: { path: undefined } }] : [];
}
---

<Layout title="Explore by space">
  <div class="wrap atlas-page">
    <header class="atlas-page-heading">
      <div>
        <p class="eyebrow">The exhibition atlas</p>
        <h1>
          Ideas have
          <br />
          <em>a place.</em>
        </h1>
      </div>
      <div>
        <p class="lead">
          Step inside. Pick a space.
          <br />
          Discover the work waiting there.
        </p>
        <a class="text-link" href="#atlas-directory-title">
          Browse the room directory ↓
        </a>
      </div>
    </header>
    <p class="atlas-proposal">
      <strong>Proposed exhibition layout</strong> Installation positions are proposed and
      may change. This schematic is not a confirmed access or wayfinding guide.
    </p>
    <ExhibitionMap />
  </div>
</Layout>
