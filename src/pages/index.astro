---
import ArrowIcon from '../components/ArrowIcon.astro';
import Layout from '../layouts/Layout.astro';
import EventFacts from '../components/EventFacts.astro';
import EventActions from '../components/EventActions.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ParticipantRoster from '../components/ParticipantRoster.astro';
import ProgrammePreview from '../components/ProgrammePreview.astro';
import ExhibitionWindow from '../components/ExhibitionWindow.astro';
import EventDescription from '../components/EventDescription.astro';
import PosterFeature from '../components/PosterFeature.astro';
import InteractiveSketch from '../components/InteractiveSketch.astro';
import HomeMap from '../components/HomeMap.astro';
import EventSupporters from '../components/EventSupporters.astro';
import NewsSocial from '../components/NewsSocial.astro';
import MotionMark from '../components/MotionMark.astro';
import MotionBackdrop from '../components/MotionBackdrop.astro';
import '../styles/home-motion.css';
import { hasMapPreview } from '../data/exhibition-map';
import { event, projects, themes, isSynthetic } from '../data/catalogue';
const featured = themes
  .flatMap(
    (theme) => projects.find((project) => project.theme === theme.id) ?? [],
  )
  .slice(0, 3);
---

<Layout showLogos={false}>
  <section class="hero wrap poster-grid motion-field" data-motion-field>
    <MotionBackdrop />
    <div class="hero-copy">
      <p class="eyebrow">
        {event.series}
        <MotionMark class="hero-mark" />
      </p>
      <h1>
        {event.title.split(' ').map((word) => (
          <span
            class:list={[
              'title-word',
              {
                'pixel-word': word.toLowerCase() === 'code',
                'culture-word': word.toLowerCase() === 'culture',
              },
            ]}
          >
            <span class="word-ink">
              {word}
              {word.toLowerCase() === 'code' && (
                <span class="code-pixels" aria-hidden="true">
                  <i class="code-pixel"></i>
                  <i class="code-pixel"></i>
                  <i class="code-pixel"></i>
                </span>
              )}
            </span>{' '}
          </span>
        ))}
      </h1>
      <p class="hero-intro">
        Explore art and creative technology at Canopy. Meet the doctoral
        researchers from De Montfort University behind the work.
      </p>
      <EventFacts />
      <div class="actions">
        <a class="button lime" href="/explore/">
          Explore the projects
          <span aria-hidden="true">
            <ArrowIcon />
          </span>
        </a>
        <a class="button outline" href="/visit/">
          Plan your visit
        </a>
      </div>
      <a class="hero-news" href="#news-social">
        News & social <span>Read the announcements</span>
        <span aria-hidden="true">↓</span>
      </a>
    </div>
    <ExhibitionWindow />
  </section>

  {hasMapPreview && <HomeMap />}
  <div class="wrap">
    <EventActions />
  </div>
  {event.description && (
    <section
      class="light-section home-about"
      aria-labelledby="event-description-heading"
    >
      <div class="wrap section event-overview">
        <div class="event-overview-heading">
          <div class="event-overview-intro">
            <p class="eyebrow">About the exhibition</p>
            <h2 id="event-description-heading">
              Explore research <em>in progress.</em>
            </h2>
            <p class="home-about-note">Try the work. Ask questions.</p>
            <a class="text-link" href="/about/">
              More about the showcase{' '}
              <span aria-hidden="true">
                <ArrowIcon />
              </span>
            </a>
          </div>
        </div>
        <EventDescription />
      </div>
    </section>
  )}
  <NewsSocial />
  <EventSupporters />
  <nav class="welcome-paths wrap" aria-label="Start exploring the showcase">
    <a href="/explore/">
      <span class="path-number" aria-hidden="true">
        01
      </span>
      <span>
        <strong>Browse the projects</strong>
        <span>Find work you would like to see.</span>
      </span>
      <span class="path-arrow" aria-hidden="true">
        <ArrowIcon />
      </span>
    </a>
    <a href="#participants">
      <span class="path-number" aria-hidden="true">
        02
      </span>
      <span>
        <strong>Meet the participants</strong>
        <span>Choose a name to see their work.</span>
      </span>
      <span class="path-arrow" aria-hidden="true">
        ↓
      </span>
    </a>
    <a href="/visit/">
      <span class="path-number" aria-hidden="true">
        03
      </span>
      <span>
        <strong>Plan your visit</strong>
        <span>Find the venue and plan your visit.</span>
      </span>
      <span class="path-arrow" aria-hidden="true">
        <ArrowIcon />
      </span>
    </a>
  </nav>
  {projects.length > 0 && (
    <section
      class="light-section home-projects"
      aria-labelledby="selected-projects-heading"
    >
      <div class="wrap section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Inside the showcase</p>
            <h2 id="selected-projects-heading">
              Selected <em>projects.</em>
            </h2>
          </div>
          <a class="text-link" href="/explore/">
            Explore all projects{' '}
            <span aria-hidden="true">
              <ArrowIcon />
            </span>
          </a>
        </div>
        <p class="section-intro">
          {isSynthetic
            ? 'Sample entries show how the guide will work. The approved programme is still to come.'
            : 'Start with these projects, then browse the full showcase.'}
        </p>
        <div class="project-grid featured-grid">
          {featured.map((project) => (
            <ProjectCard project={project} headingLevel="h3" />
          ))}
        </div>
      </div>
    </section>
  )}
  <ParticipantRoster />
  <PosterFeature showLogos={false} />
  {
    <section class="section wrap motion-field home-themes" data-motion-field>
      <MotionBackdrop />
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            {'{'} Find a starting point {'}'}
          </p>
          <h2>Explore by theme.</h2>
        </div>
        <a class="text-link" href="/explore/">
          Browse all{' '}
          <span aria-hidden="true">
            <ArrowIcon />
          </span>
        </a>
      </div>
      <p class="section-intro">
        Choose Image, World or Relation to browse projects by theme. Themes do
        not identify rooms.
      </p>
      <div class="theme-grid">
        {themes.map((theme) => (
          <a
            class:list={['theme-tile', theme.id]}
            href={
              projects.some((project) => project.theme === theme.id)
                ? `/explore/?theme=${theme.id}`
                : `/about/#thread-${theme.id}`
            }
          >
            <span class="tile-top">
              <span>
                {theme.number}
                <i
                  class="ambient-mark ambient-orbit"
                  data-ambient
                  aria-hidden="true"
                ></i>
              </span>
              <span aria-hidden="true">
                <ArrowIcon />
              </span>
            </span>
            <h3>
              <span>Code becomes</span>
              {theme.name}
            </h3>
            <p>{theme.description}</p>
          </a>
        ))}
      </div>
    </section>
  }
  <InteractiveSketch />
  {projects.some((project) => project.schedule) && <ProgrammePreview />}
  <section class="light-section">
    <div class="visit-banner wrap section">
      <div>
        <p class="eyebrow">
          {'{'} See you there {'}'}
        </p>
        <h2>
          Join us at
          <br />
          <em>{event.venue.name}.</em>
        </h2>
        <EventFacts />
      </div>
      <a class="button dark" href="/visit/">
        Plan your visit{' '}
        <span aria-hidden="true">
          <ArrowIcon />
        </span>
      </a>
    </div>
  </section>
</Layout>
<script>
  import { startHomeInteractions } from '../scripts/home-interactions';
  startHomeInteractions();
</script>

<style>
  .hero-news {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    padding: 16px 20px;
    margin-top: 20px;
    border: 1px solid var(--ct-lemon);
    color: var(--ct-lemon);
    font-weight: 700;
    line-height: 1.5;
    text-underline-offset: 5px;
  }
  .hero-news span {
    font-weight: 400;
    font-size: 0.9rem;
  }
  .hero-news span:last-child {
    margin-left: auto;
    font-size: 1.2rem;
  }
  .hero-participants {
    grid-column: 1 / -1;
    display: inline-flex;
    gap: 12px;
    align-items: center;
    width: fit-content;
    padding-block: 12px;
    font-size: 0.9rem;
    text-underline-offset: 5px;
  }
  .welcome-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-block: 24px 40px;
    gap: 12px;
  }
  .welcome-paths a {
    display: flex;
    align-items: start;
    gap: 14px;
    padding: 24px 20px;
    border: 1px solid #ffffff66;
    text-decoration: none;
    background: #22137c;
  }
  .welcome-paths a:hover {
    background: #15085a;
    border-color: var(--ct-lemon);
  }
  .path-number {
    color: var(--ct-lemon);
    font-size: 0.75rem;
    padding-top: 5px;
  }
  .welcome-paths strong {
    display: block;
    font-size: 1.15rem;
    font-weight: 500;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }
  .welcome-paths strong + span {
    color: #e3dfff;
    font-size: 0.875rem;
    line-height: 1.5;
    display: block;
  }
  .path-arrow {
    margin-left: auto;
    color: var(--ct-lemon);
    font-size: 1.4rem;
  }
  .home-about {
    --reader-paper: #f7f4ee;
    background: #f7f4ee;
    border-block: 1px solid var(--ct-line-dark);
  }
  .home-about .event-overview {
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr);
    align-items: start;
  }
  .event-overview-heading {
    position: relative;
    top: auto;
    padding-bottom: 16px;
  }
  @media (min-width: 901px) and (min-height: 720px) {
    .event-overview-heading {
      position: sticky;
      top: 140px;
    }
  }
  .event-overview-heading h2 {
    scroll-margin-top: 40px;
    font-size: clamp(2rem, 3.5vw, 3.4rem);
  }
  .event-overview-heading h2 em {
    color: var(--ct-blue);
  }
  .hero-reading {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    padding-top: 14px;
    font-size: 0.95rem;
    color: var(--ct-lemon);
    text-underline-offset: 5px;
  }
  @media (max-width: 900px) {
    .home-about .event-overview {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .event-overview-heading {
      position: relative;
      top: auto;
    }
    .event-overview-heading h2 {
      max-width: none;
    }
  }
  .home-about-note {
    max-width: 25ch;
    font-size: 1.2rem;
    line-height: 1.6;
    margin-block: 24px;
  }
  .home-sharing {
    padding-bottom: var(--ct-space-section);
  }
  @media (max-width: 900px) {
    .welcome-paths {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .welcome-paths a {
      padding: 18px;
    }
    .welcome-paths a + a {
      border-top: 0;
    }
    .welcome-paths strong {
      margin-bottom: 4px;
    }
  }
</style>
