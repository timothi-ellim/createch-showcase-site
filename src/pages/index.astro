---
import Layout from '../layouts/Layout.astro';
import EventFacts from '../components/EventFacts.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ParticipantRoster from '../components/ParticipantRoster.astro';
import ProgrammePreview from '../components/ProgrammePreview.astro';
import { event, projects, themes, isSynthetic } from '../data/catalogue';
---

<Layout>
  <section class="hero wrap poster-grid">
    <div class="hero-copy">
      <p class="eyebrow">{event.series}</p>
      <h1>
        {event.title.split(' ').map((word) => (
          <span
            class:list={[
              'title-word',
              {
                'pixel-word': word.toLowerCase() === 'code',
                'culture-word': word.toLowerCase() === 'culture',
              },
            ]}
          >
            {word}{' '}
            {word.toLowerCase() === 'code' && (
              <span class="code-pixels" aria-hidden="true">
                <i class="code-pixel"></i>
                <i class="code-pixel"></i>
                <i class="code-pixel"></i>
              </span>
            )}
          </span>
        ))}
      </h1>
      <p class="hero-intro">
        A meeting point for creative technology, art, design and research.
        Explore ideas, encounter projects and shape your own visit.
      </p>
      <EventFacts />
      <div class="actions">
        <a class="button lime" href="/explore/">
          {event.primaryAction}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="button outline" href="/visit/">
          {event.secondaryAction}
        </a>
      </div>
    </div>
    <div class="poster-margin" aria-hidden="true">
      <div class="poster-registration">
        <span>CT / 26</span>
        <span>↗</span>
      </div>
      <div class="poster-object">
        <span>{'{'}</span>
        <span class="poster-star">✳</span>
        <span>{'}'}</span>
      </div>
      <p class="poster-annotation">
        A meeting point
        <br />
        for the unexpected.
      </p>
      <div class="poster-registration">
        <span>Art ↔ Technology</span>
        <span>＋</span>
      </div>
    </div>
  </section>
  <section class="curatorial-intro light-section">
    <div class="wrap section">
      <p class="discipline-line">
        <span>Art</span>
        <span>Technology</span>
        <span>People</span>
        <span>Culture</span>
      </p>
      <h2 data-motion-reveal>
        Ideas, experiences and people
        <br />
        <em>in conversation.</em>
      </h2>
      <a class="text-link" href="/about/">
        About the showcase <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <ParticipantRoster />
  {
    <section class="section wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            {'{'} Find a starting point {'}'}
          </p>
          <h2>Follow a thread.</h2>
        </div>
        <a class="text-link" href="/explore/">
          Browse all <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="section-intro">
        Follow a theme, or follow your curiosity. These are ideas to explore,
        not rooms.
      </p>
      <div class="theme-grid">
        {themes.map((theme) => (
          <a
            class:list={['theme-tile', theme.id]}
            href={
              projects.some((project) => project.theme === theme.id)
                ? `/explore/?theme=${theme.id}`
                : `/about/#thread-${theme.id}`
            }
          >
            <span class="tile-top">
              {theme.number}
              <span aria-hidden="true">↗</span>
            </span>
            <h3>
              <span>Code becomes</span>
              {theme.name}
            </h3>
            <p>{theme.description}</p>
          </a>
        ))}
      </div>
    </section>
  }
  {projects.length > 0 && (
    <section class="light-section">
      <div class="wrap section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">A first look</p>
            <h2>Meet the possibilities.</h2>
          </div>
          <a class="text-link" href="/explore/">
            Explore all projects <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="section-intro">
          {isSynthetic
            ? 'Sample entries show how the guide will work. The approved programme is still to come.'
            : 'Discover a few starting points, then explore the full showcase.'}
        </p>
        <div class="project-grid featured-grid">
          {projects.slice(0, 3).map((project) => (
            <ProjectCard project={project} headingLevel="h3" />
          ))}
        </div>
      </div>
    </section>
  )}
  <section class="wrap discovery-break">
    {projects.length > 0 ? (
      <>
        <p>
          Leave a little room
          <br />
          <em>for the unexpected.</em>
        </p>
        <button
          class="button lime"
          data-home-surprise
          hidden
          data-project-paths={JSON.stringify(
            projects.map((project) => `/projects/${project.slug}/`),
          )}
        >
          Surprise me <span aria-hidden="true">↗</span>
        </button>
      </>
    ) : (
      <>
        <p>
          Project details
          <br />
          <em>publishing soon.</em>
        </p>
        <a class="text-link" href="/explore/">
          Meet the participants ↗
        </a>
      </>
    )}
  </section>
  <ProgrammePreview />
  <section class="light-section">
    <div class="visit-banner wrap section">
      <div>
        <p class="eyebrow">
          {'{'} See you there {'}'}
        </p>
        <h2>
          Make space for
          <br />
          <em>something new.</em>
        </h2>
        <EventFacts />
      </div>
      <a class="button dark" href="/visit/">
        Plan your visit <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>
