---
import ArrowIcon from '../components/ArrowIcon.astro';
import Layout from '../layouts/Layout.astro';
import EventFacts from '../components/EventFacts.astro';
import EventActions from '../components/EventActions.astro';
import EventLinks from '../components/EventLinks.astro';
import MapInvitation from '../components/MapInvitation.astro';
import FacilitiesList from '../components/FacilitiesList.astro';
import { event, directionsUrl } from '../data/catalogue';
---

<Layout title="Plan your visit">
  <div class="wrap section">
    <p class="eyebrow">Visitor information</p>
    <h1>Plan your visit.</h1>
    <p class="lead">Find the venue and check what you need before travelling.</p>
    <div class="visit-grid">
      <section class="reading-panel">
        <h2>When & where</h2>
        <EventFacts />
        <a class="button lime" href={directionsUrl}>
          Get directions{' '}
          <span aria-hidden="true">
            <ArrowIcon />
          </span>
        </a>
        <p class="small">Find the venue on Google Maps.</p>
      </section>
      <section class="venue-type" data-living-region>
        <span class="eyebrow">The venue</span>
        <h2>
          {event.venue.name}
          <span>{event.venue.city}</span>
        </h2>
        <p>
          {event.venue.streetAddress}
          <br />
          {event.venue.postalCode}
        </p>
        <span class="venue-mark" aria-hidden="true">
          <ArrowIcon />
        </span>
      </section>
    </div>
    <EventLinks />
    <MapInvitation />
    <EventActions />
    <section class="visit-details">
      <h2>Know before you go.</h2>
      <p>
        Please check back before travelling for the latest booking, arrival and
        access information.
      </p>
      <details open>
        <summary>Arrival & registration</summary>
        <p>{event.arrivalInformation ?? 'Arrival guidance is coming soon.'}</p>
        <p>
          {event.registrationPolicy ??
            'Booking policy information is coming soon.'}
        </p>
        {event.visitorRegistrationUrl && (
          <a class="text-link" href={event.visitorRegistrationUrl}>
            Registration information <ArrowIcon />
          </a>
        )}
      </details>
      <details open>
        <summary>Accessibility & sensory information</summary>
        <h3>Toilets at Canopy</h3>
        <FacilitiesList />
        <p>
          {event.confirmedVenueAccessInformation ??
            'Venue access guidance is coming soon.'}
        </p>
      </details>
      <details>
        <summary>Programme & finding projects</summary>
        <p>
          Explore proposed project locations on the <a href="/explore/?mode=map">map</a>.
          See the <a href="/programme/">Programme page</a> for published times to meet
          participants at their booths. Locations and hours may change.
        </p>
        <p>
          Image, World and Relation are themes. They do not identify rooms.
        </p>
      </details>
      <details>
        <summary>Contact the organiser</summary>
        {event.publicContact ? (
          <p>
            <a href={`mailto:${event.publicContact.email}`}>
              {event.publicContact.label}
            </a>
          </p>
        ) : (
          <p>
            An organiser-approved public contact is not yet available on this
            site.
          </p>
        )}
      </details>
    </section>
  </div>
</Layout>
