---
import PortalShell from '../../components/PortalShell.astro';
import { event, isPreview } from '../../data/catalogue';
export function getStaticPaths() {
  if (
    !isPreview &&
    event.participantWorkspaceUrl &&
    event.publicSiteUrl &&
    new URL(event.participantWorkspaceUrl).origin !==
      new URL(event.publicSiteUrl).origin
  )
    return [];
  return [
    { path: undefined, surface: 'queue', title: 'Review submissions' },
    { path: 'review', surface: 'review', title: 'Review this version' },
    { path: 'releases', surface: 'releases', title: 'Showcase releases' },
    { path: 'people', surface: 'people', title: 'People and access' },
  ].map(({ path, ...props }) => ({ params: { path }, props }));
}
---

<PortalShell {...Astro.props} />
