---
import ArrowIcon from '../components/ArrowIcon.astro';
import Layout from '../layouts/Layout.astro';
import MapInvitation from '../components/MapInvitation.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EventFacts from '../components/EventFacts.astro';
import EventActions from '../components/EventActions.astro';
import { projects } from '../data/catalogue';
---

<Layout title="My visit" noIndex>
  <div class="wrap section" id="shortlist">
    <p class="eyebrow">Your saved projects</p>
    <h1>My visit.</h1>
    <p class="lead">Keep track of the projects you want to see.</p>
    <p class="section-intro">
      Your shortlist stays in this browser on this device. It does not sync
      across devices. Clearing your browser data removes it. Saving a project
      does not book a place.
    </p>
    <noscript>
      <p class="notice">
        Turn on JavaScript to see your saved projects. You can still{' '}
        <a href="/explore/">browse every project</a> and note down your
        favourites.
      </p>
    </noscript>
    <MapInvitation saved />
    <p id="storage-notice" role="status"></p>
    <button hidden data-remove-unavailable class="button secondary">
      Remove unavailable entries
    </button>
    <div class="shortlist-undo" hidden data-shortlist-undo>
      <p>Your last shortlist change can be undone until you leave this page.</p>
      <button class="button secondary" data-undo-saved>
        Undo last change
      </button>
    </div>
    <div class="shortlist-toolbar" hidden>
      <p id="shortlist-count" role="status"></p>
      <a href="/explore/" class="text-link">
        Find more projects <ArrowIcon />
      </a>
      <button data-clear-saved class="button secondary">
        Clear shortlist
      </button>
      <button data-print class="button secondary">
        Print my visit
      </button>
    </div>
    <div id="shortlist-empty" class="empty-state" data-living-region hidden>
      <span class="empty-icon" aria-hidden="true">
        ＋
      </span>
      <h2>No saved projects yet.</h2>
      <p>
        {projects.length
          ? 'Choose “Save” on a project to add it here.'
          : 'Project pages are coming soon. Once they are published, you can save your favourites here to plan your day.'}
      </p>
      <a class="button lime" href="/explore/">
        Explore the showcase <ArrowIcon />
      </a>
    </div>
    <dialog
      class="clear-dialog"
      data-clear-dialog
      aria-labelledby="clear-title"
    >
      <h2 id="clear-title">Clear your shortlist?</h2>
      <p>
        Remove all saved projects from this browser. You can undo this on the
        page afterwards.
      </p>
      <div class="actions">
        <button class="button dark" data-cancel-clear>
          Keep my shortlist
        </button>
        <button class="button secondary" data-confirm-clear>
          Yes, clear shortlist
        </button>
      </div>
    </dialog>
    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard project={project} saved />
      ))}
    </div>
    <div class="visit-note" data-living-region>
      <h2>Before you set off</h2>
      <EventFacts />
      <p>
        Check the latest arrival, booking and access information before you travel.
      </p>
      <a class="text-link" href="/visit/">
        Plan your visit <ArrowIcon />
      </a>
    </div>
    <EventActions compact />
  </div>
</Layout>
