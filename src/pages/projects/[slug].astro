---
import Layout from '../../layouts/Layout.astro';
import { projects, isSynthetic, snapshot, event } from '../../data/catalogue';
import ProjectQR from '../../components/ProjectQR.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import { projectUrl, snapshotOrigin, qrPaths } from '../../lib/project-url';
import { renderProjectBody } from '../../lib/project-renderer';
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const qrEnabled = snapshot.schemaVersion === 2;
const canonicalUrl = projectUrl(snapshotOrigin(snapshot), project.slug);
const related = project.relatedIds
  .map((id) => projects.find((candidate) => candidate.id === id))
  .filter((candidate) => candidate !== undefined);
---

<Layout
  title={project.title}
  projectSlug={project.slug}
  description={`${project.maker}: ${project.invitation || project.description}${isSynthetic ? ' Synthetic local fixture; not an announced work.' : ''}`}
>
  <div class="wrap section detail">
    <a class="text-link" href="/explore/" data-back-to-results>
      ← Back to all projects
    </a>
    <Fragment
      set:html={renderProjectBody(project, {
        synthetic: isSynthetic,
        related,
        eventDateLabel: event.dateLabel,
        qrPath: qrEnabled ? qrPaths(project.slug).svg : undefined,
        canonicalUrl: isSynthetic ? undefined : canonicalUrl,
      })}
    />
    <ShareLinks project={project} />
  </div>
  {qrEnabled && (
    <ProjectQR project={project} url={canonicalUrl} synthetic={isSynthetic} />
  )}
</Layout>
