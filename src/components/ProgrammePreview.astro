---
import { projects } from '../data/catalogue';
const scheduled = projects.filter((project) => project.schedule);
---

<section
  class="programme-preview wrap section"
  aria-labelledby="programme-preview-title"
>
  <p class="eyebrow">
    {'{'} On the day {'}'}
  </p>
  <div class="section-heading">
    <h2 id="programme-preview-title">
      {scheduled.length ? 'Make a little time.' : 'A day of possibilities.'}
    </h2>
    <a class="text-link" href="/programme/">
      View programme <span aria-hidden="true">↗</span>
    </a>
  </div>
  <p class="section-intro">
    {scheduled.length
      ? 'Find the published timings and plan an encounter.'
      : 'Programme publishing soon. Explore the participants while the details take shape.'}
  </p>
</section>
