---
import ArrowIcon from './ArrowIcon.astro';
import { projects } from '../data/catalogue';
const scheduled = projects.filter((project) => project.schedule);
const hasPresence = projects.some((project) => project.invigilationWindows?.length);
---

<section
  class="programme-preview wrap section"
  aria-labelledby="programme-preview-title"
>
  <p class="eyebrow">
    {'{'} On the day {'}'}
  </p>
  <div class="section-heading">
    <h2 id="programme-preview-title">
      {scheduled.length || hasPresence ? 'Make a little time.' : 'A day of possibilities.'}
    </h2>
    <a class="text-link" href="/programme/">
      View programme <span aria-hidden="true"><ArrowIcon /></span>
    </a>
  </div>
  <p class="section-intro">
    {hasPresence ? 'Find planned artist hours and make time to meet the people behind the work.' : scheduled.length
      ? 'Find the published timings and plan an encounter.'
      : 'Programme publishing soon. Explore the participants while the details take shape.'}
  </p>
</section>
