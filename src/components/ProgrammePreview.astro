---
import ArrowIcon from './ArrowIcon.astro';
import { projects } from '../data/catalogue';
const scheduled = projects.filter((project) => project.schedule);
const hasPresence = projects.some((project) => project.invigilationWindows?.length);
---

<section
  class="programme-preview wrap section"
  aria-labelledby="programme-preview-title"
>
  <p class="eyebrow">
    {'{'} On the day {'}'}
  </p>
  <div class="section-heading">
    <h2 id="programme-preview-title">
      {hasPresence ? 'Meet the participants.' : 'Plan your day.'}
    </h2>
    <a class="text-link" href="/programme/">
      View programme <span aria-hidden="true"><ArrowIcon /></span>
    </a>
  </div>
  <p class="section-intro">
    {hasPresence ? 'See when participants plan to be at their booths. Hours may change.' : scheduled.length
      ? 'Check project timings and plan your visit.'
      : 'Programme details will appear here when confirmed. You can browse the projects now.'}
  </p>
</section>
