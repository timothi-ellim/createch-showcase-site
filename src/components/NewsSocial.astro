---
import EventLinks from './EventLinks.astro';
import MotionMark from './MotionMark.astro';
import MotionBackdrop from './MotionBackdrop.astro';
---

<section
  id="news-social"
  class="news-social motion-field"
  data-motion-field
  aria-labelledby="news-social-heading"
  tabindex="-1"
>
  <MotionBackdrop />
  <div class="wrap section">
    <div class="news-heading">
      <div>
        <p class="eyebrow">
          <MotionMark class="news-mark" />
          Follow the showcase
        </p>
        <h2 id="news-social-heading" tabindex="-1">
          News <em>& social.</em>
        </h2>
      </div>
      <p class="news-intro">
        Event announcements and conversations from Tracy Harwood, Canopy and
        LCB.
      </p>
    </div>
    <EventLinks variant="news" />
  </div>
</section>

<style>
  .news-social {
    background: var(--ct-lemon);
    color: var(--ct-ink);
    border-block: 1px solid var(--ct-ink);
  }
  .news-heading {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 32px;
    align-items: end;
    margin-bottom: 36px;
  }
  .eyebrow {
    margin: 0 0 16px;
    color: var(--ct-ink);
  }
  h2 {
    margin: 0;
    font: 500 clamp(2.8rem, 6.5vw, 6rem)/1.02 var(--ct-font-display);
    letter-spacing: -0.055em;
  }
  h2 em {
    color: var(--ct-blue);
  }
  .news-intro {
    max-width: 36ch;
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .news-heading {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }
  }
</style>
