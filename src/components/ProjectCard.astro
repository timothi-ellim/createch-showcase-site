---
import ArrowIcon from './ArrowIcon.astro';
import type { PublicProject } from '../data/catalogue';
import { isSynthetic } from '../data/catalogue';
import ProjectMedia from './ProjectMedia.astro';
import { mapProjects } from '../data/exhibition-map';
interface Props {
  project: PublicProject;
  saved?: boolean;
  discover?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const {
  project,
  saved = false,
  discover = false,
  headingLevel: Heading = 'h2',
} = Astro.props;
---

<article
  id={`project-${project.id}`}
  tabindex="-1"
  class:list={['project-card', { 'type-card': !project.media }]}
  data-project-card
  data-id={project.id}
  data-theme={project.theme}
  data-encounters={project.encounters.join('|')}
  data-title={project.title}
  data-maker={project.maker}
  data-search={`${project.title} ${project.maker} ${project.invitation} ${project.theme} ${project.encounters.join(' ')}`.toLowerCase()}
  hidden={saved}
>
  <div class="card-artwork">
    <a
      class="card-media-link"
      href={`/projects/${project.slug}/`}
      data-project-media-link
      tabindex="-1"
      aria-label={`View ${project.title}`}
    >
      {discover && !project.media ? (
        <div
          class:list={['discovery-type-cover', project.theme]}
          aria-hidden="true"
        >
          <span>Code becomes {project.theme}</span>
          <strong>{project.title}</strong>
          <span>{project.maker} · Explore the idea ↗</span>
        </div>
      ) : (
        <ProjectMedia project={project} />
      )}
    </a>
    {project.media && (
      <button
        hidden
        class="artwork-peek"
        data-open-artwork={project.id}
        aria-label={`View artwork for ${project.title}`}
      >
        View artwork <span aria-hidden="true">⤢</span>
      </button>
    )}
  </div>
  <div class="card-copy">
    {isSynthetic && (
      <p class="fixture-label">Synthetic fixture · Not an announced work</p>
    )}
    <p class:list={['theme-label', project.theme]}>
      Code becomes {project.theme}
    </p>
    <Heading>
      <a data-project-link href={`/projects/${project.slug}/`}>
        {project.title}
        <span class="card-arrow" aria-hidden="true">
          <ArrowIcon />
        </span>
      </a>
    </Heading>
    <p class="maker">{project.maker}</p>
    {project.invitation && <p>{project.invitation}</p>}
    {discover && (
      <div class="discovery-card-links">
        <a data-project-link href={`/projects/${project.slug}/`}>
          Explore work <ArrowIcon />
        </a>
        {mapProjects.some((row) => row.project.id === project.id) && (
          <a
            href={`/explore/?mode=map&project=${project.id}`}
            data-locate-project={project.id}
          >
            Locate on map <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    )}
    <div class="card-bottom">
      {project.encounters.length > 0 && (
        <span class="tag">{project.encounters.join(' · ')}</span>
      )}
      <button
        hidden
        data-save={project.id}
        data-title={project.title}
        aria-pressed="false"
        aria-label={`Save ${project.title} to my visit`}
        class="save-button"
      >
        ＋ Save
      </button>
    </div>
  </div>
</article>
