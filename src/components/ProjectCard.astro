---
import type { PublicProject } from '../data/catalogue';
import { isSynthetic } from '../data/catalogue';
import ProjectMedia from './ProjectMedia.astro';
interface Props {
  project: PublicProject;
  saved?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { project, saved = false, headingLevel: Heading = 'h2' } = Astro.props;
---

<article
  id={`project-${project.id}`}
  tabindex="-1"
  class:list={['project-card', { 'type-card': !project.media }]}
  data-project-card
  data-id={project.id}
  data-theme={project.theme}
  data-encounters={project.encounters.join('|')}
  data-title={project.title}
  data-maker={project.maker}
  data-search={`${project.title} ${project.maker} ${project.invitation} ${project.theme} ${project.encounters.join(' ')}`.toLowerCase()}
  hidden={saved}
>
  <a
    class="card-media-link"
    href={`/projects/${project.slug}/`}
    data-project-media-link
    tabindex="-1"
    aria-label={`View ${project.title}`}
  >
    <ProjectMedia project={project} />
  </a>
  <div class="card-copy">
    {isSynthetic && (
      <p class="fixture-label">Synthetic fixture · Not an announced work</p>
    )}
    <p class:list={['theme-label', project.theme]}>
      Code becomes {project.theme}
    </p>
    <Heading>
      <a data-project-link href={`/projects/${project.slug}/`}>
        {project.title}
        <span class="card-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    </Heading>
    <p class="maker">{project.maker}</p>
    <p>{project.invitation}</p>
    <div class="card-bottom">
      <span class="tag">{project.encounters.join(' · ')}</span>
      <button
        hidden
        data-save={project.id}
        data-title={project.title}
        aria-pressed="false"
        aria-label={`Save ${project.title} to my visit`}
        class="save-button"
      >
        ＋ Save
      </button>
    </div>
  </div>
</article>
