---
import PosterImage from './PosterImage.astro';
import ShareLinks from './ShareLinks.astro';
import LogoStrip from './LogoStrip.astro';
import ArrowIcon from './ArrowIcon.astro';
import { event } from '../data/catalogue';
interface Props { showLogos?: boolean }
const { showLogos = true } = Astro.props;
import { promotion } from '../data/promotion';
---
<section class="poster-feature light-section" aria-labelledby="poster-heading" id="poster">
  <div class="wrap section">
    <div class="poster-feature-grid">
      <figure>
        <a href="/poster/" aria-label="View the full event poster"><PosterImage /></a>
        {event.designCredit && <figcaption>{event.designCredit}</figcaption>}
      </figure>
      <div class="poster-feature-copy">
        <p class="eyebrow">The official event poster</p>
        <h2 id="poster-heading">Take the showcase <em>with you.</em></h2>
        <p>Save the poster, pass it on, and bring someone curious along.</p>
        <div class="actions">
          <a class="button dark" href={promotion.poster} download={promotion.posterFileName}>Download poster <ArrowIcon /></a>
          <a class="text-link" href="/poster/">View full poster <ArrowIcon /></a>
        </div>
        <p class="poster-file-note">JPG · 960 × 1200 · 1.9 MB</p>
        <p class="poster-roster-note">The poster’s participant list is being updated. <a href="/explore/">Explore the current projects.</a></p>
        <ShareLinks compact />
      </div>
    </div>
    {showLogos && <LogoStrip compact />}
  </div>
</section>
<style>
  .poster-feature { background: #f7f4ee; color: var(--ct-ink); scroll-margin-top: 110px; }
  .poster-feature-grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(30px, 5vw, 80px); align-items: start; }
  figure { margin: 0; max-width: 440px; width: 100%; justify-self: center; }
  figure a { display: block; border: 1px solid #cbc7d7; }
  figcaption { font-size: .8rem; line-height: 1.5; margin-top: 12px; }
  h2 { font-size: clamp(2.3rem, 4.2vw, 4rem); margin-block: 16px 20px; max-width: 13ch; }
  h2 em { color: var(--ct-blue); }
  .poster-feature-copy > p { line-height: 1.6; }
  .actions { align-items: center; gap: 20px; margin-top: 26px; }
  .poster-file-note { font-size: .8rem; margin-top: 12px; }
  .poster-roster-note { font-size: .85rem; margin-block: 20px 0; }
  a:focus-visible { outline: 3px solid var(--ct-blue); outline-offset: 5px; }
  @media(max-width: 850px) { .poster-feature-grid { grid-template-columns: 1fr; } h2 { max-width: 20ch; } }
</style>
