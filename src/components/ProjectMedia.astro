---
import { mediaLicenceMarkup } from '../lib/media-licence';
import ArrowIcon from './ArrowIcon.astro';
import type { PublicProject } from '../data/catalogue';
import { responsiveMedia } from '../lib/responsive-media';
interface Props {
  project: PublicProject;
  linkToProject?: boolean;
}
const { project, linkToProject = false } = Astro.props;
const MediaContainer = linkToProject ? 'a' : 'div';
---

<figure class="project-figure">
  <MediaContainer
    class:list={[
      'project-media',
      project.theme,
      { 'card-media-link': linkToProject },
    ]}
    href={linkToProject ? `/projects/${project.slug}/` : undefined}
    data-project-media-link={linkToProject || undefined}
    tabindex={linkToProject ? -1 : undefined}
    aria-label={linkToProject ? `View ${project.title}` : undefined}
  >
    {project.media ? (
      <img
        src={project.media.src}
        srcset={responsiveMedia(project.media.src)}
        sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 45vw"
        alt={project.media.alt}
        loading="lazy"
        width="960"
        height="640"
      />
    ) : (
      <>
        <span class="placeholder-symbol" aria-hidden="true">
          {project.theme === 'image' ? (
            '◉'
          ) : project.theme === 'world' ? (
            <ArrowIcon />
          ) : (
            '⤫'
          )}
        </span>
        <span class="placeholder-caption">Project image not supplied</span>
      </>
    )}
  </MediaContainer>
  {project.media && (
    <figcaption>
      {project.media.credit}
      <Fragment set:html={mediaLicenceMarkup(project.media.src)} />
    </figcaption>
  )}
</figure>

<style>
  .project-media.card-media-link {
    display: flex;
    text-decoration: none;
  }
  .project-media.card-media-link:hover {
    background-color: var(--ct-lilac);
  }
</style>
