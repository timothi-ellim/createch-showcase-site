---
interface Props {
  icon: string;
}
const { icon } = Astro.props;
const paths: Record<string, string> = {
  cup: 'M4 8h12v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8ZM16 9h2a3 3 0 1 1 0 6h-2M7 3v2M11 3v2M3 22h15',
  door: 'M4 21V3h12v18M9 21V6l7-3M19 10l3 3-3 3M12 13h10',
  info: 'M12 11v6M12 7v.2M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z',
  leaf: 'M5 19C0 7 10 3 21 3c0 11-4 21-16 16ZM3 21 16 8',
};
---

<svg
  class="atlas-landmark-icon"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {icon === 'wc' ? (
    <text x="12" y="16" text-anchor="middle">
      WC
    </text>
  ) : (
    <path d={paths[icon] ?? paths.info} />
  )}
</svg>
