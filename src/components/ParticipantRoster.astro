---
import { event, projects } from '../data/catalogue';
const participants = [...event.participants].sort((a, b) =>
  a.name.localeCompare(b.name, 'en'),
);
---

{event.participants.length > 0 && (
  <section
    class="roster-section light-section"
    id="participants"
    aria-labelledby="participant-roster-heading"
  >
    <div class="wrap section">
      <p class="eyebrow">The people behind the showcase</p>
      <div class="section-heading">
        <h2 id="participant-roster-heading">
          Meet the <em>participants.</em>
        </h2>
        <span class="roster-count">{participants.length} creative voices</span>
      </div>
      <p class="section-intro">
        Get to know the people behind the ideas. Choose a name to explore their
        project and research.
        {event.participants.every((participant) =>
          projects.some((project) => project.id === participant.projectId),
        )
          ? ''
          : ' Project pages will appear here as they are ready.'}
      </p>
      <ul class="participant-roster">
        {participants.map((participant, index) => {
          const project = projects.find(
            (item) => item.id === participant.projectId,
          );
          return (
            <li>
              {project ? (
                <a href={`/projects/${project.slug}/`}>
                  <span class="roster-number" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="roster-person">
                    <h3>{participant.name}</h3>
                    <span class="roster-project">{project.title}</span>
                  </span>
                  <span class="roster-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ) : (
                <div class="roster-pending">
                  <h3>{participant.name}</h3>
                  <span>Project page coming soon</span>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<style>
  .roster-section {
    scroll-margin-top: 20px;
  }
  .roster-section .section-heading {
    align-items: center;
    gap: 20px;
  }
  .roster-section h2 {
    margin-bottom: 0;
  }
  .roster-count {
    border: 1px solid var(--ct-blue);
    color: var(--ct-blue);
    border-radius: 30px;
    padding: 9px 16px;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .participant-roster {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .participant-roster li {
    min-width: 0;
  }
  .participant-roster h3 {
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.035em;
  }
  .participant-roster a {
    display: flex;
    gap: 12px;
    align-items: start;
    height: 100%;
    padding: 22px 18px;
    border: 1px solid #d4d1c7;
    background: #fffefa;
    color: var(--ct-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .participant-roster a:hover {
    border-color: var(--ct-blue);
    background: #f0edff;
  }
  .participant-roster a:hover h3 {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .roster-person {
    min-width: 0;
  }
  .roster-project {
    display: block;
    margin-top: 10px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #514b60;
  }
  .roster-number {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 0.7rem;
    color: var(--ct-blue);
    padding-top: 5px;
  }
  .roster-arrow {
    margin-left: auto;
    font-size: 1.4rem;
    color: var(--ct-blue);
  }
  .roster-pending {
    height: 100%;
    border: 1px solid #d4d1c7;
    padding: 22px 18px;
  }
  .roster-pending span {
    display: block;
    font-size: 0.875rem;
    margin-top: 10px;
  }
  @media (max-width: 1000px) {
    .participant-roster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .participant-roster {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .roster-section .section-heading {
      align-items: start;
    }
  }
</style>
