---
import { event, isPreview } from '../data/catalogue';
import { shareText } from '../lib/discovery';
import type { PublicProject } from '../lib/content-schema';
interface Props {
  project?: PublicProject;
}
const { project } = Astro.props;
const path = project ? `/projects/${project.slug}/` : '/';
// A preview always shares its local address, never an unpublished public URL.
const url = new URL(path, isPreview ? Astro.url.origin : event.publicSiteUrl!)
  .href;
const title = project
  ? `${project.title} | ${event.series}`
  : `${event.title} | ${event.series}`;
const text = shareText(event, project);
const id = project ? 'share-project' : 'share-event';
const channels = [
  {
    name: 'Email',
    label: 'Share by email',
    href: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${text}\n\n${url}`)}`,
    icon: 'M4 5h16v14H4z M4 6l8 7 8-7',
  },
  ...(!isPreview
    ? [
        {
          name: 'WhatsApp',
          label: 'WhatsApp',
          href: `https://wa.me/?text=${encodeURIComponent(`${text}\n\n${url}`)}`,
          icon: 'M21 11.5a9 9 0 0 1-13.5 7.8L3 21l1.7-4.5A9 9 0 1 1 21 11.5Z M8 7c0 5 4 9 9 9l1-3-3-1-1 2-4-4 2-1-1-3Z',
        },
        {
          name: 'Facebook',
          label: 'Facebook',
          href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
          icon: 'M14 21V12h3l.5-4H14V6c0-1 .5-2 2-2h2V1h-3c-3 0-5 2-5 5v2H7v4h3v9',
        },
        {
          name: 'LinkedIn',
          label: 'LinkedIn',
          href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
          icon: 'M4 9v12 M4 4v.1 M10 21V9 M10 14c0-6 10-6 10 0v7',
        },
      ]
    : []),
];
---

<section
  class="share-links"
  aria-labelledby={`${id}-heading`}
  data-share-links
  data-share-url={url}
  data-share-title={title}
  data-share-text={text}
>
  <div class="share-invitation">
    <p class="share-eyebrow">
      <span aria-hidden="true">↗</span>{' '}
      {project ? 'Share this project' : 'Share the showcase'}
    </p>
    <h2 id={`${id}-heading`}>
      <span>{project ? 'Found something' : 'Curiosity is'}</span>
      <em>{project ? 'worth sharing?' : 'better shared.'}</em>
    </h2>
    <p class="share-intro">
      {project
        ? 'Send this project to someone who sees things a little differently.'
        : 'Art, ideas and unexpected possibilities. Bring someone curious along.'}
    </p>
    <div class="share-signoff">
      <svg
        class="share-spark"
        viewBox="0 0 80 80"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="40" cy="40" r="29" />
        <path d="M20 60 60 20H30 M60 20v30 M40 0v12 M40 68v12 M0 40h12 M68 40h12" />
      </svg>
      <p>
        {event.dateLabel}
        <br />
        <span>
          {event.venue.name}, {event.venue.city}
        </span>
      </p>
    </div>
  </div>
  <div class="share-controls">
    <p class="share-prompt">A good discovery deserves company.</p>
    <div class="share-primary">
      <button class="share-action share-native" data-native-share hidden>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M12 16V3m-5 5 5-5 5 5M5 13v8h14v-8" />
        </svg>
        Share…{' '}
        <span class="share-action-arrow" aria-hidden="true">
          ↗
        </span>
      </button>
      <button class="share-action share-copy" data-share-copy hidden>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
          focusable="false"
        >
          <rect x="8" y="8" width="12" height="13" rx="2" />
          <path d="M15 8V3H3v12h5" />
        </svg>
        Copy link{' '}
        <span class="share-action-arrow" aria-hidden="true">
          ↗
        </span>
      </button>
    </div>
    <div class="share-channels">
      {channels.map((channel) => (
        <a
          class="share-channel"
          aria-label={channel.label}
          href={channel.href}
          rel="noopener noreferrer"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d={channel.icon} />
          </svg>
          {channel.name}
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <details class="share-address" data-share-fallback>
      <summary>
        <span>Get the {project ? 'project' : 'event'} link</span>
        <span class="share-expand" aria-hidden="true">
          +
        </span>
      </summary>
      <label for={`${id}-url`}>Copy this address to share</label>
      <input id={`${id}-url`} type="url" value={url} readonly />
    </details>
    <p
      class="share-feedback"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-share-feedback
    ></p>
    {isPreview && (
      <p class="share-preview-note">
        This is a local preview link. Public sharing will use the published
        website address.
      </p>
    )}
  </div>
</section>
<script>
  import '../scripts/share';
</script>
<style>
  .share-links {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 80px);
    position: relative;
    isolation: isolate;
    margin-top: 32px;
    padding: clamp(24px, 4vw, 56px);
    border: 1px solid var(--ct-blue);
    border-radius: 24px;
    background: var(--ct-blue);
    color: #fff;
  }
  .share-links::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(ellipse at 0 100%, #7565ff55, transparent 65%);
    pointer-events: none;
  }
  .share-links .share-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 26px;
    color: var(--ct-lemon);
    font: 500 0.75rem/1.4 var(--ct-font-pixel);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .share-eyebrow > span {
    font-size: 1.5rem;
    line-height: 1;
  }
  .share-links h2 {
    margin: 0 0 24px;
    max-width: none;
    font-size: clamp(2.2rem, 4.7vw, 4.4rem);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.055em;
    text-wrap: initial;
    color: #fff;
  }
  .share-links h2 > * {
    display: block;
  }
  .share-links h2 em {
    color: var(--ct-lemon);
    font-weight: 400;
  }
  .share-links .share-intro {
    max-width: 34ch;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #fff;
  }
  .share-signoff {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 30px;
  }
  .share-spark {
    width: 66px;
    height: 66px;
    flex-shrink: 0;
    color: var(--ct-lemon);
  }
  .share-signoff p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.7;
    color: #fff;
  }
  .share-signoff p span {
    color: #e4dfff;
  }
  .share-controls {
    align-self: center;
    min-width: 0;
  }
  .share-links .share-prompt {
    margin: 0 0 18px;
    font-size: 1rem;
    color: #fff;
  }
  .share-primary {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .share-action {
    display: flex;
    flex: 1 1 155px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 64px;
    padding: 16px 20px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
  }
  .share-action[hidden] {
    display: none;
  }
  .share-native {
    background: #fff;
    color: var(--ct-blue-deep);
  }
  .share-copy {
    background: var(--ct-lemon);
    color: var(--ct-ink);
  }
  .share-action svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .share-action-arrow {
    font-size: 1.3rem;
    margin-left: auto;
  }
  .share-channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 14px;
  }
  .share-channel {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 12px 16px;
    border: 1px solid #b7aaff;
    border-radius: 14px;
    background: #ffffff0a;
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .share-channel svg {
    width: 21px;
    height: 21px;
    flex-shrink: 0;
  }
  .share-channel > span {
    margin-left: auto;
  }
  .share-links .share-address {
    margin-top: 20px;
    border: 0;
    padding: 0;
  }
  .share-address summary {
    min-height: 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 10px 2px;
    border-bottom: 1px solid #b7aaff;
    list-style: none;
    cursor: pointer;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 400;
  }
  .share-address summary::-webkit-details-marker {
    display: none;
  }
  .share-expand {
    font-size: 1.4rem;
    line-height: 1;
  }
  .share-address[open] .share-expand {
    transform: rotate(45deg);
  }
  .share-address label {
    display: block;
    margin-top: 18px;
    color: #fff;
    font-size: 0.8rem;
  }
  .share-address input {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 50px;
    margin-top: 8px;
    padding: 12px;
    border: 1px solid #fff;
    border-radius: 8px;
    background: #fff;
    color: var(--ct-ink);
    font-size: 0.9rem;
  }
  .share-links .share-feedback {
    min-height: 1.5em;
    margin: 10px 0 0;
    color: var(--ct-lemon);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .share-links .share-preview-note {
    margin: 12px 0 0;
    color: #fff;
    font-size: 0.8rem;
  }
  .share-links :is(a, button, summary, input):focus-visible {
    outline: 3px solid var(--ct-lemon);
    outline-offset: 4px;
    box-shadow: 0 0 0 4px var(--ct-blue-deep);
  }
  @media (hover: hover) {
    .share-action:hover {
      background: #fff;
      color: var(--ct-blue-deep);
    }
    .share-channel:hover {
      background: #fff;
      border-color: #fff;
      color: var(--ct-blue-deep);
    }
    .share-address summary:hover {
      color: var(--ct-lemon);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion-level='off'])) .share-action,
    :global(html:not([data-motion-level='off'])) .share-channel {
      transition:
        background-color 160ms,
        color 160ms,
        transform 160ms;
    }
    :global(html:not([data-motion-level='off'])) .share-action-arrow {
      transition: transform 160ms;
    }
    .share-action:hover .share-action-arrow {
      transform: translate(2px, -2px);
    }
    .share-action:active,
    .share-channel:active {
      transform: translateY(1px);
    }
  }
  @media (max-width: 850px) {
    .share-links {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }
    .share-links h2 {
      font-size: clamp(2.2rem, 7vw, 3.8rem);
    }
    .share-signoff {
      margin-top: 22px;
    }
    .share-spark {
      width: 48px;
      height: 48px;
    }
  }
  @media (max-width: 400px) {
    .share-links {
      padding: 22px 18px;
      border-radius: 18px;
    }
    .share-channel {
      gap: 7px;
      padding-inline: 10px;
      font-size: 0.8rem;
    }
    .share-channel svg {
      width: 18px;
      height: 18px;
    }
    .share-channel > span {
      display: none;
    }
  }
  @media (forced-colors: active) {
    .share-links,
    .share-action,
    .share-channel {
      background: Canvas;
      color: CanvasText;
      border-color: CanvasText;
    }
    .share-links::before {
      display: none;
    }
    .share-links :is(h2, p, em, summary, label),
    .share-signoff p span,
    .share-spark {
      color: CanvasText;
    }
    .share-links :is(a, button, summary, input):focus-visible {
      outline-color: Highlight;
      box-shadow: none;
    }
  }
  @media print {
    .share-links {
      display: none;
    }
  }
</style>
