---
import ArrowIcon from './ArrowIcon.astro';
import { projects } from '../data/catalogue';
import { restingPose, sketchPaths } from '../lib/interactive-sketch';
const paths = sketchPaths(restingPose);
---

<section
  class="interactive-sketch wrap"
  id="play"
  aria-labelledby="play-heading"
  tabindex="-1"
  data-sketch
>
  <div class="sketch-copy">
    <div class="sketch-intro">
      <p class="eyebrow">Your turn</p>
      <h2 id="play-heading">
        Play with
        <br />
        <em>shape and motion.</em>
      </h2>
      <p>
        Turn, stretch and blend this website sketch. See what happens when you
        take control.
      </p>
    </div>
  </div>
  <div
    class="sketch-stage"
    data-sketch-stage
    role="group"
    aria-label="Turn the interactive sculpture"
    aria-describedby="sketch-instructions"
    aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home"
  >
    <div class="sketch-stage-heading">
      <span>Code / Play</span>
      <span data-sketch-label>01 — Orbit</span>
    </div>
    <svg
      viewBox="0 0 600 440"
      aria-hidden="true"
      focusable="false"
      class="sketch-drawing"
    >
      <defs>
        <linearGradient id="sketch-spectrum" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fbfc7f" />
          <stop offset=".45" stop-color="#d9ccff" />
          <stop offset="1" stop-color="#ff9ad5" />
        </linearGradient>
      </defs>
      <g
        fill="none"
        stroke="url(#sketch-spectrum)"
        stroke-width="1.4"
        stroke-linecap="round"
      >
        {paths.map((d) => (
          <path d={d} data-sketch-line />
        ))}
      </g>
      <circle
        cx="300"
        cy="220"
        r="207"
        fill="none"
        stroke="#bfb3ff"
        stroke-opacity=".25"
        stroke-dasharray="2 10"
      />
      <path
        d="M22 44V22h22 M556 22h22v22 M578 396v22h-22 M44 418H22v-22"
        stroke="#fbfc7f"
        fill="none"
      />
    </svg>
    <div class="sketch-stage-footer">
      <span>Interactive website sketch</span>
      <span aria-hidden="true">✳</span>
    </div>
  </div>
  <div class="sketch-interaction">
    <p
      class="sketch-instructions"
      id="sketch-instructions"
      data-sketch-instructions
      hidden
    >
      Move your pointer across the sculpture. Try a shape, or use Turn to see
      another angle.
    </p>
    <div class="sketch-controls" data-sketch-controls hidden>
      <div class="shape-options" role="group" aria-label="Sculpture shape">
        {['Orbit', 'Wave', 'Bloom'].map((name, index) => (
          <button
            type="button"
            data-sketch-shape={index}
            aria-pressed={index === 0}
          >
            {name}
          </button>
        ))}
      </div>
      <div class="sketch-blend">
        <div class="blend-label">
          <label for="sketch-blend">Blend the shapes</label>
          <output for="sketch-blend" data-sketch-output>
            Orbit
          </output>
        </div>
        <input
          id="sketch-blend"
          data-sketch-blend
          type="range"
          min="0"
          max="100"
          step="1"
          value="0"
          aria-valuetext="Orbit"
        />
        <div class="blend-stops" aria-hidden="true">
          <span>Orbit</span>
          <span>Wave</span>
          <span>Bloom</span>
        </div>
      </div>
      <div class="sketch-view-controls">
        <button class="sketch-turn" type="button" data-sketch-turn>
          Turn the sculpture <span aria-hidden="true">↻</span>
        </button>
        <button class="sketch-reset" type="button" data-sketch-reset>
          Reset
        </button>
      </div>
    </div>
    {projects.length > 0 && (
      <button
        class="text-link sketch-surprise"
        hidden
        data-home-surprise
        data-project-paths={JSON.stringify(
          projects.map((project) => `/projects/${project.slug}/`),
        )}
      >
        Surprise me{' '}
        <span aria-hidden="true">
          <ArrowIcon />
        </span>
      </button>
    )}
  </div>
</section>
<script>
  import '../scripts/interactive-sketch';
</script>

<style>
  .interactive-sketch {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
    grid-template-areas: 'intro drawing' 'controls drawing';
    row-gap: 12px;
    padding-block: var(--ct-space-section);
    border-top: 1px solid var(--ct-line-light);
  }
  .sketch-copy {
    grid-area: intro;
  }
  .sketch-interaction {
    grid-area: controls;
  }
  .sketch-stage {
    grid-area: drawing;
    align-self: center;
  }
  .sketch-copy h2 {
    font-size: clamp(2.3rem, 4.5vw, 4.5rem);
    line-height: 1.05;
    margin-block: 20px 24px;
  }
  .sketch-copy h2 em {
    color: var(--ct-lemon);
  }
  .sketch-intro > p:not(.eyebrow) {
    max-width: 40ch;
    line-height: 1.7;
  }
  .sketch-instructions {
    font-size: 0.875rem;
    color: #e2dcff;
    line-height: 1.6;
    max-width: 44ch;
  }
  .sketch-controls {
    margin-top: 24px;
  }
  .shape-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .shape-options button,
  .sketch-turn {
    font: inherit;
    font-size: 0.9rem;
    min-height: 48px;
    padding: 10px 22px;
    border: 1px solid #ffffff88;
    color: white;
    background: transparent;
    border-radius: 999px;
    cursor: pointer;
  }
  .shape-options button:hover,
  .sketch-turn:hover {
    background: #211067;
  }
  .shape-options button[aria-pressed='true'] {
    color: #111217;
    background: var(--ct-lemon);
    border-color: var(--ct-lemon);
  }
  .sketch-turn {
    margin-top: 12px;
    padding-left: 0;
    border: 0;
    border-radius: 0;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .sketch-turn span {
    display: inline-block;
    margin-left: 12px;
    font-size: 1.3rem;
  }
  .sketch-blend {
    margin-top: 24px;
    max-width: 360px;
  }
  .blend-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.85rem;
  }
  .blend-label output {
    color: var(--ct-lemon);
  }
  .sketch-blend input {
    display: block;
    width: 100%;
    min-height: 44px;
    margin: 4px 0 0;
    padding: 0;
    accent-color: var(--ct-lemon);
    cursor: ew-resize;
  }
  .blend-stops {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: #e2dcff;
  }
  .sketch-view-controls {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .sketch-reset {
    background: transparent;
    border: 1px solid #ffffff88;
    border-radius: 999px;
    color: inherit;
    font: inherit;
    font-size: 0.9rem;
    padding: 10px 18px;
    min-height: 48px;
    cursor: pointer;
  }
  .sketch-reset:hover {
    background: #211067;
  }
  .sketch-stage[data-interactive-motion='true'] {
    cursor: grab;
    touch-action: pan-y pinch-zoom;
  }
  .sketch-stage[data-dragging] {
    cursor: grabbing;
    user-select: none;
  }
  .sketch-stage:focus-visible,
  .sketch-controls :is(button, input):focus-visible {
    outline: 3px solid var(--ct-lemon);
    outline-offset: 5px;
  }
  .sketch-surprise {
    margin-top: 20px;
    color: white;
    background: none;
    border: 0;
    padding: 12px 0;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }
  .sketch-stage {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #9d8bea;
    border-radius: 20px;
    background-color: #130b35;
    background-image: radial-gradient(#54427955 1px, transparent 1px);
    background-size: 22px 22px;
    box-shadow: 12px 12px 0 #1c0a90;
  }
  .sketch-stage-heading,
  .sketch-stage-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 22px 24px;
    font: 0.75rem var(--ct-font-pixel);
    color: #ded7f5;
  }
  .sketch-stage-heading {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .sketch-stage-heading > span:first-child {
    color: var(--ct-lemon);
  }
  .sketch-stage-footer {
    padding-top: 0;
  }
  .sketch-stage-footer > span:last-child {
    color: var(--ct-lemon);
    font-size: 1.5rem;
  }
  .sketch-drawing {
    display: block;
    width: 100%;
    height: auto;
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 800px) {
    .interactive-sketch {
      grid-template-columns: 1fr;
      grid-template-areas: 'intro' 'drawing' 'controls';
      gap: 20px;
    }
    .sketch-interaction {
      display: flex;
      flex-direction: column;
    }
    .sketch-intro {
      order: 0;
    }
    .sketch-interaction {
      order: 2;
    }
    .sketch-intro h2 {
      margin-block: 16px;
    }
    .sketch-intro > p:last-child {
      margin-bottom: 0;
    }
    .sketch-stage {
      order: 1;
      box-shadow: 6px 6px 0 #1c0a90;
    }
    .sketch-drawing {
      max-height: 260px;
    }
    .sketch-stage-heading,
    .sketch-stage-footer {
      padding: 14px 16px;
    }
    .sketch-instructions {
      order: 2;
      margin-top: 20px;
    }
    .sketch-surprise {
      order: 3;
      margin-top: 0;
    }
    .sketch-controls {
      margin-top: 0;
    }
  }
  @media (max-width: 400px) {
    .sketch-stage-heading,
    .sketch-stage-footer {
      padding-inline: 16px;
      font-size: 0.65rem;
    }
  }
  @media print {
    .sketch-controls,
    .sketch-surprise,
    .sketch-instructions {
      display: none;
    }
    .sketch-stage {
      box-shadow: none;
    }
  }
</style>
