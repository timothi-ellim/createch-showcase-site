---
import ArrowIcon from './ArrowIcon.astro';
import { eventLinks, venueLinks, newsLinks } from '../data/event-links';
interface Props {
  variant?: 'venue' | 'news';
}
const { variant = 'venue' } = Astro.props;
const isNews = variant === 'news';
const links = isNews ? newsLinks : venueLinks;
---

<nav
  class:list={['event-links', { 'news-links': isNews }]}
  aria-label={isNews ? 'News and social links' : 'Event and venue links'}
>
  {links.map((link) => (
    <a href={link.href} class:list={{ featured: isNews && link === eventLinks.tracy }}>
      {isNews ? (
        <>
          <span class="link-category">{link.category}</span>
          <h3>{link.label}</h3>
          <p class="link-description">{link.description}</p>
          <span class="link-action">{link.action} <ArrowIcon /></span>
        </>
      ) : (
        <>
          <span>
            <strong>{link.label}</strong>
            <span class="link-description">{link.description}</span>
          </span>
          <ArrowIcon />
        </>
      )}
    </a>
  ))}
</nav>

<style>
  .event-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-block: 28px;
  }
  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px;
    color: var(--ct-ink);
    background: #fff;
    border: 1px solid #d9d3e5;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  strong {
    display: block;
    color: var(--ct-blue);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .link-description {
    display: block;
    margin-top: 8px;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  a:hover {
    border-color: var(--ct-blue);
  }
  a:focus-visible {
    outline: 3px solid var(--ct-blue);
    outline-offset: 4px;
  }
  .news-links {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
  }
  .news-links a {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 0;
    min-width: 0;
    padding: clamp(24px, 2.5vw, 36px);
    border: 1px solid var(--ct-ink);
    box-shadow: 5px 5px 0 var(--ct-ink);
  }
  .news-links a.featured {
    background: var(--ct-blue);
    color: #fff;
  }
  .link-category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.5;
    margin-bottom: 28px;
  }
  h3 {
    margin: 0 0 16px;
    font: 500 clamp(1.5rem, 2.3vw, 2.2rem)/1.12 var(--ct-font-display);
    letter-spacing: -0.035em;
  }
  .news-links .link-description {
    margin: 0 0 28px;
    font-size: 1rem;
    line-height: 1.6;
  }
  .link-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid currentColor;
    font-weight: 700;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .featured .link-action {
    color: var(--ct-lemon);
  }
  .news-links a:hover h3 {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .news-links a:focus-visible {
    outline-color: var(--ct-ink);
    outline-width: 4px;
    outline-offset: 7px;
  }
  @media (max-width: 900px) {
    .news-links {
      grid-template-columns: 1fr;
    }
    .link-category {
      margin-bottom: 16px;
    }
  }
  @media (max-width: 650px) {
    .event-links {
      grid-template-columns: 1fr;
    }
  }
</style>
