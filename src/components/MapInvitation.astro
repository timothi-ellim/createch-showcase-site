---
import { hasMapPreview } from '../data/exhibition-map';
import ArrowIcon from './ArrowIcon.astro';
import '../styles/exhibition-map.css';
interface Props {
  saved?: boolean;
}
const { saved = false } = Astro.props;
---

{hasMapPreview && (
  <a class="atlas-invitation" href={saved ? '/explore/?mode=map&saved=1' : '/explore/?mode=map'}>
    <span class="atlas-invitation-symbol" aria-hidden="true">
      ⌑
    </span>
    <span>
      <span class="atlas-kicker">
        Exhibition map
      </span>
      <strong>
        {saved
          ? 'See your saved projects on the map.'
          : 'Explore the exhibition map.'}
      </strong>
      <span>
        Browse the Gallery, WS09 and WS10. Project locations are proposed and
        may change.
      </span>
    </span>
    <ArrowIcon />
  </a>
)}
