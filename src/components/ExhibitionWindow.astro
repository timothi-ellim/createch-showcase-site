---
import ArrowIcon from './ArrowIcon.astro';
import { projects, themes } from '../data/catalogue';
import { responsiveMedia } from '../lib/responsive-media';
const opening =
  projects.find((project) => project.media && project.theme === 'world') ??
  projects.find((project) => project.media);
const glimpses = themes
  .filter((theme) => theme.id !== opening?.theme)
  .flatMap(
    (theme) =>
      projects.find((project) => project.media && project.theme === theme.id) ??
      [],
  )
  .slice(0, 2);
---

{opening?.media && (
  <aside class="exhibition-window" aria-label="A window into the exhibition">
    <div class="window-heading">
      <span>
        <i class="ambient-mark ambient-star" data-ambient aria-hidden="true">
          ✳
        </i>
        A glimpse inside
      </span>
      <span>
        {projects.length} projects <ArrowIcon />
      </span>
    </div>
    <a
      class="window-artwork"
      href={`/projects/${opening.slug}/`}
      aria-label={`Discover ${opening.title}`}
    >
      <img
        src={opening.media.src}
        srcset={responsiveMedia(opening.media.src)}
        sizes="(max-width: 767px) 100vw, 45vw"
        alt={opening.media.alt}
        width="960"
        height="640"
        fetchpriority="high"
      />
      <span class="window-corner" aria-hidden="true">
        <ArrowIcon />
      </span>
    </a>
    <div class="window-caption">
      <p>
        {opening.title}
        <span>{opening.maker}</span>
      </p>
    </div>
    <div class="window-glimpses">
      {glimpses.map(
        (project) =>
          project.media && (
            <a href={`/projects/${project.slug}/`}>
              <img
                src={project.media.src}
                srcset={responsiveMedia(project.media.src)}
                sizes="(max-width: 767px) 42vw, 20vw"
                alt={project.media.alt}
                width="320"
                height="180"
                loading="lazy"
              />
              <span>
                {project.maker}
                <span aria-hidden="true">
                  <ArrowIcon />
                </span>
              </span>
            </a>
          ),
      )}
    </div>
    <button class="button lime" hidden data-open-gallery>
      Enter artwork viewer <span aria-hidden="true">⤢</span>
    </button>
    <p class="window-note">
      Take a closer look. Move between the works at your own pace.
    </p>
  </aside>
)}

<style>
  .window-artwork img {
    aspect-ratio: 2.1;
  }
  .window-glimpses {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }
  .window-glimpses a {
    min-width: 0;
    text-decoration: none;
  }
  .window-glimpses img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2.4;
    object-fit: contain;
    background: #0e0d14;
  }
  .window-glimpses a > span {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.8rem;
    line-height: 1.4;
    padding-top: 8px;
  }
  .window-glimpses a:hover > span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .window-glimpses span span {
    color: var(--ct-lemon);
  }
</style>
