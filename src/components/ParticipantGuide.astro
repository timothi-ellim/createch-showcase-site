---
const singleSignIn = import.meta.env.PUBLIC_PARTICIPANT_AUTH_V2 === 'true';
---

<section class="reading-panel" aria-labelledby="participant-guide-title">
  <h2 id="participant-guide-title">A guide to updating your page</h2>
  <p>
    Use the illustrated guide to sign in, edit your page, choose an image and
    submit your changes for review.
  </p>
  <p>
    You can still update your page. Save your changes, then submit them for review.
  </p>
  <a
    class="button dark"
    href="https://createch-showcase.pages.dev/guides/CreaTech-Participant-Guide.pdf"
  >
    Download the visual walkthrough (PDF)
  </a>
  <p class="small">
    {singleSignIn ? 'Seven' : 'Six'} pages, with labelled steps and screenshots
    using sample content.
  </p>
</section>
