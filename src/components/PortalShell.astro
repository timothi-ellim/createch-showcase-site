---
import WorkspaceLayout from '../layouts/WorkspaceLayout.astro';
import '../styles/portal.css';
import { event } from '../data/catalogue';
interface Props {
  surface: string;
  title: string;
}
const { surface, title } = Astro.props;
const standalone = import.meta.env.MODE === 'portal-staging';
const singleSignIn = import.meta.env.PUBLIC_PARTICIPANT_AUTH_V2 === 'true';
const organiserSurface = ['queue', 'review', 'releases', 'people'].includes(
  surface,
);
---

<WorkspaceLayout title={title} privatePage>
  <div class="wrap section portal" data-portal={surface}>
    <p class="eyebrow">
      CreaTech · {organiserSurface ? 'Organiser' : 'Participant'} workspace
    </p>
    <h1>{title}</h1>
    <p class="portal-intro">
      {organiserSurface
        ? 'Review submissions, manage access and prepare showcase releases.'
        : 'Your words and images. One shared showcase page.'}
    </p>
    <nav
      class="portal-nav"
      aria-label="Workspace navigation"
      hidden
      data-private-nav
    >
      <a
        href="/participant/"
        aria-current={
          surface === 'dashboard' ||
          surface === 'editor' ||
          surface === 'preview'
            ? 'page'
            : undefined
        }
      >
        My projects
      </a>
      <a
        href="/organiser/"
        hidden
        data-organiser-link
        aria-current={
          surface === 'queue' || surface === 'review' ? 'page' : undefined
        }
      >
        Review queue
      </a>
      <a
        href="/organiser/releases/"
        hidden
        data-organiser-link
        aria-current={surface === 'releases' ? 'page' : undefined}
      >
        Releases
      </a>
      <a
        href="/organiser/people/"
        hidden
        data-organiser-link
        aria-current={surface === 'people' ? 'page' : undefined}
      >
        People
      </a>
      <button class="text-button" data-signout>
        Sign out
      </button>
    </nav>
    <p
      class="portal-status"
      data-portal-status
      role="status"
      aria-live="polite"
    >
      Checking editor availability…
    </p>
    <noscript>
      <p class="reading-panel">
        The participant editor needs JavaScript to sign in and save.
        {standalone ? (
          <a href="/participants/">Read participant help</a>
        ) : (
          <a href="/explore/">Browse the public showcase</a>
        )}
        .{' '}
        {event.publicContact ? (
          <a href={`mailto:${event.publicContact.email}`}>
            Contact CreaTech support
          </a>
        ) : (
          'For help, use your existing organiser contact.'
        )}
      </p>
    </noscript>
    <section
      class="portal-login reading-panel"
      data-login
      hidden
      aria-labelledby="login-heading"
    >
      <h2 id="login-heading">
        {singleSignIn
          ? 'Sign in to your CreaTech page'
          : 'Sign in to your workspace'}
      </h2>
      <p>
        Use the email address invited by the organiser.{' '}
        {!standalone && 'Visitors can browse without signing in.'}
      </p>
      {singleSignIn ? (
        <>
          <form data-email-form>
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
            />
            <p class="small">
              Use the email address where you received your invitation.
            </p>
            <div class="sign-in-actions">
              <button class="button dark" type="submit" data-send-code>
                Email me a code
              </button>
              <button class="text-button" type="button" data-existing-code>
                I already have a code
              </button>
            </div>
          </form>
          <form data-code-form hidden>
            <h3>Check your email</h3>
            <p class="small" data-code-address></p>
            <label for="email-code">Email code</label>
            <input
              id="email-code"
              name="code"
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              pattern="[0-9]{6}"
              minlength="6"
              maxlength="12"
              required
              aria-describedby="code-help"
            />
            <p id="code-help" class="small">
              Use the latest six-digit code. It expires 24 hours after it was
              sent. You can request a new code when needed.
            </p>
            <div class="sign-in-actions">
              <button class="button dark" type="submit">
                Continue
              </button>
              <button class="text-button" type="button" data-resend-code>
                Send a new code
              </button>
              <button class="text-button" type="button" data-change-email>
                Change email
              </button>
            </div>
          </form>
        </>
      ) : (
        <>
          <form data-email-form>
            <label for="email">Invited email address</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
            />
            <button class="button dark" type="submit" data-send-code>
              Send email code
            </button>
          </form>
          <form data-code-form>
            <p class="small">
              Already have an invitation code? Enter it below without requesting
              another code.
            </p>
            <label class="invitation-choice">
              <input id="first-invitation" type="checkbox" /> This is my first
              invitation code
            </label>
            <label for="email-code">Email code</label>
            <input
              id="email-code"
              name="code"
              inputmode="numeric"
              autocomplete="one-time-code"
              pattern="[0-9]{6,8}"
              minlength="6"
              maxlength="8"
              required
              aria-describedby="code-help"
            />
            <p id="code-help" class="small">
              Paste the code from your email. A code request does not confirm
              delivery.
            </p>
            <button class="button dark" type="submit">
              Verify code
            </button>
          </form>
        </>
      )}
      <p class="small">
        Closing this tab may require you to sign in again. Unsaved text is kept
        only while this page remains open.
      </p>
      <a class="text-link" href="/participants/">
        Participant help ↗
      </a>
      {event.publicContact && (
        <p class="small">
          Need a hand?{' '}
          <a href={`mailto:${event.publicContact.email}`}>
            {event.publicContact.email}
          </a>
        </p>
      )}
    </section>
    <section
      class="reading-panel"
      data-mfa
      hidden
      aria-labelledby="mfa-heading"
    >
      <h2 id="mfa-heading">Verify organiser access</h2>
      <p>
        Approvals, releases and membership changes require an authenticator
        code.
      </p>
      <button class="button dark" data-mfa-start>
        Set up or use authenticator
      </button>
      <div data-mfa-setup></div>
      <form data-mfa-form hidden>
        <label for="mfa-code">Authenticator code</label>
        <input
          id="mfa-code"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9]{6}"
          maxlength="6"
          required
        />
        <button class="button dark">Verify authenticator</button>
      </form>
    </section>
    <div data-private-content hidden></div>
    <p class="portal-help">
      Saving a draft, submitting for review and publication are separate steps.
      Your public page changes only after an approved release is verified.
    </p>
  </div>
  <script>
    import '../scripts/portal';
  </script>
</WorkspaceLayout>
