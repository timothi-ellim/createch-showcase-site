---
import '../styles/global.css';
import '../styles/redesign.css';
import '../styles/exhibition.css';
import '../styles/ambient-motion.css';
import ArtworkViewer from '../components/ArtworkViewer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  pageDescription,
  socialImagePath,
  eventStructuredData,
  jsonLd,
} from '../lib/discovery';
import { motionLevel } from '../lib/motion/config';
import {
  event,
  contentRevision,
  isPreview,
  isSynthetic,
} from '../data/catalogue';
interface Props {
  title?: string;
  description?: string;
  privatePage?: boolean;
  noIndex?: boolean;
  projectSlug?: string;
}
const {
  title,
  privatePage = false,
  noIndex = false,
  projectSlug,
  description = pageDescription(event, Astro.url.pathname),
} = Astro.props;
const path = Astro.url.pathname;
const indexable = !isPreview && !privatePage && !noIndex;
const canonicalUrl =
  !isPreview && !privatePage && event.publicSiteUrl
    ? new URL(path, event.publicSiteUrl).href
    : null;
const pageTitle = title
  ? `${title} | ${event.series}`
  : `${event.title} | ${event.series}`;
const imagePath = socialImagePath(projectSlug);
const imageUrl = canonicalUrl
  ? new URL(imagePath, event.publicSiteUrl!).href
  : imagePath;
const imageAlt = `${title ?? event.title} — ${event.series}. ${event.dateLabel}, ${event.startTime}–${event.endTime} (UK time), ${event.venue.name}, ${event.venue.city}.`;
const structuredData =
  indexable && path === '/' ? eventStructuredData(event) : null;
---

<!doctype html>
<html lang="en" data-motion-level={motionLevel}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {indexable && (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}
    <meta name="referrer" content="no-referrer" />
    <meta name="createch-revision" content={contentRevision} />
    {canonicalUrl && !noIndex && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={event.series} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={jsonLd(structuredData)}
      ></script>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/motion.css" />
  </head>
  <body
    data-synthetic={String(isSynthetic)}
    data-preview={String(isPreview)}
    data-page={
      privatePage
        ? 'private'
        : path === '/'
          ? 'home'
          : path === '/explore/'
            ? 'explore'
            : 'reading'
    }
  >
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {isPreview && (
      <div class="preview-notice" role="region" aria-label="Preview notice">
        <span>LOCAL PREVIEW</span>{' '}
        {isSynthetic
          ? 'Project entries are synthetic. Event details are organiser-confirmed.'
          : 'Approved content preview. This is not the live public website.'}
      </div>
    )}
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p class="footer-statement" aria-hidden="true">
        Stay curious.
        <i class="ambient-mark ambient-star" data-ambient>
          ✳
        </i>
        <span>Code becomes culture ↗</span>
      </p>
      <div>
        <a class="brand" href="/">
          CreaTech<span>{event.title.toUpperCase()}</span>
        </a>
        <p>
          {event.dateLabel} · {event.venue.name}, {event.venue.city}
        </p>
      </div>
      <div class="footer-links">
        <a href="/explore/">Browse all projects</a>
        <a href="/programme/">Programme</a>
        <a href="/about/">About</a>
        <a href="/participants/">Participant help</a>
        <a href="/visit/">Plan your visit</a>
      </div>
      <p class="footer-note">
        {isSynthetic
          ? 'Local development preview. No participant catalogue has been approved for publication.'
          : 'Explore the showcase at your own pace. Your shortlist stays in this browser.'}
      </p>
      {event.designCredit && <p class="footer-note">{event.designCredit}</p>}
    </footer>
    <div
      id="status"
      class="status-toast"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>
    {!privatePage && <ArtworkViewer />}
    {!privatePage && <script>
      import '../scripts/visitor';
    </script>}
    <script>
      import '../lib/motion/boot';
      import '../scripts/ambient-motion';
    </script>
  </body>
</html>
